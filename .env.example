# Environment variables for Docker Compose
# Скопируйте этот файл в .env и заполните свои значения

# PostgreSQL Configuration
POSTGRES_USER=ski_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=ski_concierge
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_PORT=3001
ADMIN_PORT=3002
ADMIN_API_URL=https://infokurort.ru/api

# Frontend Configuration  
FRONTEND_PORT=80

# Backend values belong in backend/.env.production (see backend/.env.example).
# Never commit production secrets.
